generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement()) @map("id_rol")
  name  String @unique @map("nombre") @db.VarChar(50)
  users User[]

  @@map("roles")
}

model User {
  id        Int      @id @default(autoincrement()) @map("id_usuario")
  firstName String   @map("nombre") @db.VarChar(50)
  lastName  String   @map("apellido") @db.VarChar(50)
  address   String?  @map("direccion") @db.VarChar(100)
  contact   String?  @map("contacto") @db.VarChar(50)
  dni       String   @unique @db.VarChar(20)
  roleId    Int?     @map("id_rol")
  createdAt DateTime @map("creado_en")
  updatedAt DateTime @map("actualizado_en")

  role         Role?         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  guests       Guest[]
  fines        UserFine[]
  expenses     UserExpense[]
  reservations Reservation[]
  webUsers     WebUser[]
  claim        Claim?
  accessRecord AccessRecord?

  @@map("usuarios")
}

model Guest {
  id           Int      @id @default(autoincrement()) @map("id_invitado")
  firstName    String   @map("nombre") @db.VarChar(50)
  lastName     String   @map("apellido") @db.VarChar(50)
  visitDate    DateTime @map("fecha_visita")
  exitDate     DateTime @map("fecha_salida")
  dni          String   @unique @db.VarChar(20)
  visitType    String?  @map("tipo_visita") @db.VarChar(35)
  reason       String?  @map("motivo") @db.VarChar(50)
  userId       Int      @map("id_usuario")
  contact      String?  @map("contacto") @db.VarChar(120)
  observations String   @map("observaciones") @db.VarChar(1024)
  status       String?  @map("estado") @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("invitados")
}

model AccessRecord {
  id           Int      @id @default(autoincrement()) @map("id_accesos")
  accessType   String   @map("acceso_tipo") @db.VarChar(50)
  accessMedium String   @map("acceso_medio") @db.VarChar(50)
  accessDate   DateTime @map("fecha_acceso") @db.Date
  dni          String   @unique @db.VarChar(20)
  permission   String?  @map("permiso") @db.VarChar(30)
  details      String?  @map("detalles") @db.VarChar(255)

  user User @relation(fields: [dni], references: [dni], onDelete: Restrict, onUpdate: Restrict)

  @@map("registro_accesos")
}

model Claim {
  id          Int     @id @default(autoincrement()) @map("id_reclamo")
  title       String? @map("titulo") @db.VarChar(50)
  category    String? @map("categoria") @db.VarChar(50)
  priority    String? @map("prioridad") @db.VarChar(30)
  location    String? @map("ubicacion") @db.VarChar(120)
  description String? @map("descripcion") @db.VarChar(512)
  dni         String  @unique @db.VarChar(20)

  user User @relation(fields: [dni], references: [dni], onDelete: Restrict, onUpdate: Restrict)

  @@map("reclamos")
}

model Fine {
  id          Int       @id @default(autoincrement()) @map("id_multa")
  description String    @map("descripcion") @db.VarChar(150)
  cause       String?   @map("causa") @db.VarChar(150)
  issueDate   DateTime? @map("fecha_emision")
  status      String?   @map("estado") @db.VarChar(50)

  users UserFine[]

  @@map("multas")
}

model UserFine {
  userId Int @map("id_usuario")
  fineId Int @map("id_multa")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fine Fine @relation(fields: [fineId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, fineId])
  @@map("usuarios_multas")
}

model Expense {
  id            Int       @id @default(autoincrement()) @map("id_expensa")
  period        String    @map("periodo") @db.VarChar(50)
  issueDate     DateTime  @map("fecha_emision")
  dueDate       DateTime  @map("fecha_vencimiento")
  status        String    @map("estado") @db.VarChar(50)
  paymentDate   DateTime? @map("fecha_pago")
  paymentMethod String?   @map("metodo_pago") @db.VarChar(50)
  dni           String    @unique @map("dni") @db.VarChar(20)

  items ExpenseItem[]
  users UserExpense[]

  @@map("expensas")
}

model ExpenseItem {
  id          Int    @id @default(autoincrement()) @map("id_item")
  expenseId   Int    @map("id_expensa")
  title       String @map("titulo") @db.VarChar(50)
  description String @map("descripcion") @db.VarChar(250)
  amount      Int    @map("monto")

  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("expensas_items")
}

model UserExpense {
  userId    Int     @map("id_usuario")
  expenseId Int     @map("id_expensa")
  amount    Decimal @map("monto") @db.Decimal(10, 2)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, expenseId])
  @@map("usuarios_expensas")
}

model PublicSpace {
  id              Int      @id @default(autoincrement()) @map("id_espacio")
  name            String   @map("nombre") @db.VarChar(100)
  characteristics String   @map("caracteristicas") @db.VarChar(150)
  address         String   @map("direccion") @db.VarChar(150)
  price           Decimal  @default(0) @map("precio") @db.Decimal(10, 2)
  openingTime     DateTime @map("hora_apertura") @db.Time(0)
  closingTime     DateTime @map("hora_cierre") @db.Time(0)
  usageCondition  String   @map("condicion_uso") @db.VarChar(150)
  capacity        Int      @map("capacidad")
  availability    String   @map("disponibilidad") @db.VarChar(50)

  reservations Reservation[]

  @@map("espacios_publicos")
}

model Reservation {
  id              Int      @id @default(autoincrement()) @map("id_reserva")
  reservationDate DateTime @map("fecha_reserva")
  dni             String   @map("id_usuario")
  spaceId         Int      @map("id_espacio")
  startTime       DateTime @map("hora_inicio")
  endTime         DateTime @map("hora_fin")
  peopleCount     Int      @map("cantidad_personas")
  observations    String?  @map("obsrevaciones") @db.VarChar(1024)

  user  User?        @relation(fields: [dni], references: [dni], onDelete: Restrict, onUpdate: Restrict)
  space PublicSpace? @relation(fields: [spaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("reservas")
}

model WebSession {
  id             String   @id @db.VarChar(36)
  userId         String   @map("usuario_id") @db.VarChar(36)
  ip             String   @db.VarChar(45)
  userAgent      String   @map("user_agent") @db.VarChar(512)
  active         Boolean  @map("activo") @db.TinyInt
  createdDate    DateTime @map("fecha_creacion")
  expirationDate DateTime @map("fecha_expiracion")

  webUser WebUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sesiones_web_ibfk_1")

  @@map("sesiones_web")
}

model WebUser {
  id         String  @id @db.VarChar(36)
  dni        String  @unique @db.VarChar(20)
  avatarHash String  @map("avatar_hash") @db.VarChar(128)
  email      String  @unique @map("correo_electronico") @db.VarChar(255)
  password   String  @map("contrasena") @db.VarChar(255)
  admin      Boolean @default(false) @db.TinyInt

  user     User         @relation(fields: [dni], references: [dni], onDelete: Restrict, onUpdate: Restrict, map: "FK_usuarios_web_usuarios")
  sessions WebSession[]

  @@map("usuarios_web")
}
